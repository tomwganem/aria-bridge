# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional legacy Google Fit REST API OAuth bearer token (server-side only).
# Leave blank to run Google Fit REST requests in dry-run payload preview mode.
GOOGLE_FIT_ACCESS_TOKEN=""

# Optional fixed Android Health Connect pairing token for the local bridge host.
# If unset, AriaBridge Lab generates and persists a secure random token locally.
HEALTH_CONNECT_PAIRING_TOKEN=""
